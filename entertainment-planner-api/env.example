# Environment configuration
APP_ENV=staging
PORT=8000
API_BASE=/api

# Database configuration
DATABASE_URL=postgresql+psycopg://<user>:<pass>@planner-db-staging.internal:5432/<db>

# Feature flags
ALLOW_TEXT_FALLBACK=0
COMPOSE_DISABLE_PARSER=0
TRACE_RAILS=1

# Background tasks
REFRESH_MV_INTERVAL=300  # prod: 0 (disabled)

# Debug
SMOKE_MOCK=0