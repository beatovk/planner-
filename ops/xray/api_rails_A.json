pe views.","tags_csv":"category:restaurant,category:bar,vibe:trendy,experience:rooftop,drink:cocktail_bar,feature:outdoor,area:sukhumvit,price:$$$,cuisine:peruvian,cuisine:japanese,dish:ceviche,scenario:date","category":"Bar","lat":13.7456558,"lng":100.55676549999998,"address":null,"picture_url":"https://lh3.googleusercontent.com/places/ANXAkqFGnr9kYkkL4BSmTH7iS0ORr1fN3FBPNnhue1vZxJrwNrzTtKcw1r5_Xj4D-KRyo3myk3krhJ_3LcAldMXdRddi3BVvTN7ht_Y=s4800-w1600","website":null,"phone":null,"price_level":null,"rating":4.6,"distance_m":null,"walk_time_min":null,"search_score":13.816524,"vibe_score":0.0,"novelty_score":0.7,"badges":["👑 Editor Pick","💎 Local Gem","💕 Date Night"],"signals":{"hooks":["Rooftop dining experience","Fusion cocktails galore"],"evidence":["panoramic sunset views","Nikkei food combination","stylish Central Park-inspired design"],"local_gem":true,"dateworthy":true,"vista_view":true,"editor_pick":true,"trend_score":0.6,"extraordinary":true,"hq_experience":true,"novelty_score":0.7,"quality_score":0.8,"interest_score":0.74,"extraordinary_cluster":null},"reason":"Matches your search","why":"Rooftop dining experience"},{"id":379,"name":"Red Sky","summary":"Bangkok's nightlife shines at Red Sky, a top-rated rooftop bar known for its vibrant atmosphere and diverse weekly parties. Guests can indulge in delicious food and expertly crafted drinks while enjoying stunning city views. The venue continues to innovate, making it a must-visit for both locals and travelers alike.","tags_csv":"category:bar,vibe:lively,experience:rooftop,drink:cocktail_bar,feature:outdoor,area:pathum_wan,price:$$$,cuisine:fusion,scenario:friends,view:skyline","category":"Restaurant","lat":13.747433599999999,"lng":100.5386748,"address":null,"picture_url":"https://lh3.googleusercontent.com/places/ANXAkqEfhYVITOfqEYYG99hnzFhPfFpIpWQptlnD-IY722V2u3iYyjjZ1hHZ2Ofp_4YzuH-5DFolmrxGHCYno3Gg-ZIvy8rSOrBALJc=s4800-w1600","website":null,"phone":null,"price_level":null,"rating":4.5,"distance_m":null,"walk_